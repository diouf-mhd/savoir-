{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "User profile information",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "maxLength": 128 },
        "displayName": { "type": "string", "maxLength": 100 },
        "email": { "type": "string", "maxLength": 100 },
        "level": { "type": "string", "maxLength": 50 },
        "photoUrl": { "type": "string", "maxLength": 500 },
        "isAdmin": { "type": "boolean" },
        "createdAt": { "type": "number" }
      },
      "required": ["uid", "displayName", "email", "level", "createdAt"]
    },
    "Course": {
      "title": "Course",
      "description": "Educational course chapter",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "title": { "type": "string", "maxLength": 200 },
        "subject": { "type": "string", "maxLength": 50 },
        "level": { "type": "string", "maxLength": 50 },
        "chapter": { "type": "string", "maxLength": 200 },
        "summary": { "type": "string", "maxLength": 1000 },
        "content": { "type": "string", "maxLength": 10000 },
        "createdAt": { "type": "number" }
      },
      "required": ["id", "title", "subject", "level", "chapter", "createdAt"]
    },
    "Asset": {
      "title": "Asset",
      "description": "Educational document or media asset",
      "type": "object",
      "properties": {
        "assetId": { "type": "string", "maxLength": 128 },
        "parentId": { "type": "string", "maxLength": 128 },
        "name": { "type": "string", "maxLength": 200 },
        "type": { "type": "string", "maxLength": 20 },
        "size": { "type": "string", "maxLength": 50 },
        "storagePath": { "type": "string", "maxLength": 500 },
        "downloadUrl": { "type": "string", "maxLength": 500 },
        "isCachedOffline": { "type": "boolean" },
        "level": { "type": "string", "maxLength": 50 },
        "subject": { "type": "string", "maxLength": 50 }
      },
      "required": ["assetId", "name", "type", "storagePath", "downloadUrl"]
    },
    "Quiz": {
      "title": "Quiz",
      "description": "Quiz assessment with multiple choice questions",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "title": { "type": "string", "maxLength": 200 },
        "subject": { "type": "string", "maxLength": 50 },
        "level": { "type": "string", "maxLength": 50 },
        "createdAt": { "type": "number" }
      },
      "required": ["id", "title", "subject", "level", "createdAt"]
    },
    "PaymentTransaction": {
      "title": "PaymentTransaction",
      "description": "Payment transaction record for tuition or domicile courses",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "userUid": { "type": "string", "maxLength": 128 },
        "userName": { "type": "string", "maxLength": 100 },
        "learnerName": { "type": "string", "maxLength": 100 },
        "type": { "type": "string", "maxLength": 50 },
        "paymentType": { "type": "string", "maxLength": 50 },
        "selectedMonth": { "type": "string", "maxLength": 50 },
        "level": { "type": "string", "maxLength": 50 },
        "amount": { "type": "number" },
        "operator": { "type": "string", "maxLength": 50 },
        "phoneNumber": { "type": "string", "maxLength": 50 },
        "status": { "type": "string", "maxLength": 20 },
        "createdAt": { "type": "number" },
        "dateFormatted": { "type": "string", "maxLength": 100 },
        "tuteurName": { "type": "string", "maxLength": 100 },
        "address": { "type": "string", "maxLength": 200 },
        "weeklyHours": { "type": "string", "maxLength": 50 },
        "serie": { "type": "string", "maxLength": 50 },
        "rejectionReason": { "type": "string", "maxLength": 500 }
      },
      "required": ["id", "userUid", "userName", "learnerName", "type", "paymentType", "level", "amount", "operator", "phoneNumber", "status", "createdAt"]
    },
    "UserNotification": {
      "title": "UserNotification",
      "description": "User notification item",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "userUid": { "type": "string", "maxLength": 128 },
        "title": { "type": "string", "maxLength": 200 },
        "message": { "type": "string", "maxLength": 1000 },
        "type": { "type": "string", "maxLength": 50 },
        "status": { "type": "string", "maxLength": 20 },
        "transactionId": { "type": "string", "maxLength": 128 },
        "createdAt": { "type": "number" },
        "dateFormatted": { "type": "string", "maxLength": 100 }
      },
      "required": ["id", "userUid", "title", "message", "type", "status", "createdAt"]
    },
    "SystemConfig": {
      "title": "SystemConfig",
      "description": "System configuration for app updates and settings",
      "type": "object",
      "properties": {
        "latest_version": { "type": "string", "maxLength": 20 },
        "apk_url": { "type": "string", "maxLength": 1000 },
        "message": { "type": "string", "maxLength": 500 },
        "updatedAt": { "type": "number" }
      },
      "required": ["latest_version", "apk_url"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserProfile" },
      "description": "User profiles collection"
    },
    "/courses/{courseId}": {
      "schema": { "$ref": "#/entities/Course" },
      "description": "Courses collection"
    },
    "/assets/{assetId}": {
      "schema": { "$ref": "#/entities/Asset" },
      "description": "Educational assets collection"
    },
    "/quizzes/{quizId}": {
      "schema": { "$ref": "#/entities/Quiz" },
      "description": "Quizzes collection"
    },
    "/transactions/{transactionId}": {
      "schema": { "$ref": "#/entities/PaymentTransaction" },
      "description": "Payment transactions collection"
    },
    "/notifications/{notificationId}": {
      "schema": { "$ref": "#/entities/UserNotification" },
      "description": "User notifications collection"
    },
    "/system/{configId}": {
      "schema": { "$ref": "#/entities/SystemConfig" },
      "description": "System application configuration and update collection"
    }
  }
}
